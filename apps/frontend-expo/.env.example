# Existing frontend-vite/.env public values are used as fallbacks locally.
# Physical devices need a reachable HTTPS/LAN backend, not localhost.
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Set after linking this app with `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Same PostHog project as the web app (falls back to VITE_POSTHOG_KEY/HOST).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
