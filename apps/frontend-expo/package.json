    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/query-async-storage-persister": "^5.90.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-query-persist-client": "^5.90.0",
    "@tsw/prisma": "workspace:*",
    "axios": "^1.12.2",
    "date-fns": "^4.1.0",
    "expo": "~57.0.21",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.17",
    "expo-calendar": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-glass-effect": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "html-to-image": "^1.11.13",
    "lottie-react-native": "~7.3.8",
    "lucide-react-native": "^1.44.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.34",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "@types/react": "~19.2.2",
    "dotenv": "^16.6.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "node e2e/live/seed.cjs && playwright test --config playwright.live.config.ts",
    "build:preview": "pnpm dlx eas-cli@24.0.0 build --profile preview --platform all",
    "build:production": "pnpm dlx eas-cli@24.0.0 build --profile production --platform all",
    "submit:ios": "pnpm dlx eas-cli@24.0.0 submit --platform ios",
    "submit:android": "pnpm dlx eas-cli@24.0.0 submit --platform android",
    "build:simulator": "pnpm dlx eas-cli@24.0.0 build --profile simulator --platform ios",
    "test:e2e:android": "node e2e/native/run.cjs",
    "test:e2e:ios": "node e2e/native/run.cjs --ios",
    "build:iphone": "node --import tsx scripts/iphone/cli.ts release",
    "build:iphone:check": "node --import tsx scripts/iphone/cli.ts check",
    "build:iphone:local": "node --import tsx scripts/iphone/cli.ts build",
    "build:iphone:package": "node --import tsx scripts/iphone/cli.ts package",
    "build:iphone:publish": "node --import tsx scripts/iphone/cli.ts publish",
    "build:testflight": "node --import tsx scripts/iphone/testflight.ts build",
    "validate:testflight": "node --import tsx scripts/iphone/testflight.ts validate",
    "submit:testflight": "node --import tsx scripts/iphone/testflight.ts submit",
    "build:iphone:cloud": "pnpm dlx eas-cli@24.0.0 build --profile device-production --platform ios"
  },
  "private": true
}
