NODE_ENV=development
PORT=8000

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/tracking_so?schema=public"

# Redis (in-flight coach response status)
REDIS_URL="redis://localhost:6379"

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Email Configuration
EMAIL_FROM=noreply@tracking.so
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# AI providers. OpenRouter is preferred for speech-to-text when configured.
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
STT_MODEL=nvidia/parakeet-tdt-0.6b-v3

# AI data sharing consent (App Store 5.1.2). Leave unset until the app build
# that asks for consent is live; "true" then blocks AI for people who haven't allowed it.
AI_CONSENT_ENFORCED=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
AI_GATEWAY_MODEL=openai/gpt-5.6-luna

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_APP_NAME=tracking.so
# Routine product activity (new users, coach diagnostics, testimonials)
TELEGRAM_CHAT_IDS=your-telegram-chat-id
# High-priority operations (5xx errors, billing, important bugs, CI failures)
# Falls back to TELEGRAM_CHAT_IDS while unset for backward compatibility.
TELEGRAM_ALERT_CHAT_IDS=your-important-app-alerts-chat-id
BACKEND_5XX_TELEGRAM_ENABLED=true
CLIENT_ERROR_TELEGRAM_ENABLED=false

# PostHog
POSTHOG_PROJECT_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://app.posthog.com

# Linear
LINEAR_API_KEY=your-linear-api-key

# Garmin Connect legacy OAuth 1.0 (keep the secret values out of source control)
GARMIN_CONNECT_CONSUMER_KEY=
GARMIN_CONNECT_CONSUMER_SECRET=
GARMIN_TOKEN_ENCRYPTION_KEY=
GARMIN_REDIRECT_URI=https://api.tracking.so/health/garmin/callback
GARMIN_API_BASE_URL=https://apis.garmin.com/wellness-api/rest
